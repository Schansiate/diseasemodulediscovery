/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run nf-core/diseasemodulediscovery -profile test_samplesheet,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/
process {
    resourceLimits = [
        cpus: 2,
        memory: '6.GB',
        time: '1.h'
    ]
    memory = '1.GB'
    withName: DIGEST {
        memory = '6.GB'
    }
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset to check pipeline function with a samplesheet'

    // Input data
    input                   = "${projectDir}/tests/test_samplesheet.csv"
    validate_online         = false
    run_seed_perturbation    = false
    run_network_perturbation = false
    run_proximity           = false
    skip_domino             = true
    skip_rwr                = true
    skip_robust             = true
    skip_robust_bias_aware  = true
    skip_firstneighbor      = true
    skip_digest             = true
    drug_to_target          = "${projectDir}/tests/subset_drug_target_geneid.tsv"
    n_network_perturbations  = 3
}
